# Cleo frontend build settings. Copy to Frontend/.env (never committed) and run:  node source/build.js
# The build embeds these values in index.html, where EVERY visitor can read them.
# Only public values belong here. The build refuses secret and service-role keys.

# What the app runs on: supabase (the real backend, default) or demo (the sample business).
CLEO_DATA_SOURCE=supabase

# on (default): ?demo in the address opens the sample business, stored apart from real records.
# off: the demo is left out of the build entirely (recommended for production).
CLEO_DEMO=on

# Your Supabase project (Project Settings > API Keys). Leave empty until configured:
# the app then says it isn't connected, and nothing is simulated.
# URL: https://<project-ref>.supabase.co  (http is accepted only for a local Supabase on localhost)
# Enter the plain project origin, not a Markdown link, dashboard URL or /auth endpoint.
CLEO_SUPABASE_URL=
# The publishable key (sb_publishable_...) or the legacy anon key. NEVER the secret or service_role key.
CLEO_SUPABASE_PUBLISHABLE_KEY=

# The official Supabase browser SDK is vendored in assets/vendor; no CDN is required.
# Serve Frontend/ with node source/serve.js. Root opens the landing; index.html is the
# auth callback and operational app. In Authentication > URL Configuration > Redirect URLs,
# allow the app path with its callback queries, e.g. http://localhost:5175/index.html**
# for local development. The suffix supports sb_flow_id and auth=recovery. Never allow
# arbitrary external origins. Replace local origins with the verified HTTPS host at launch.
# Set Supabase's Site URL to your served landing origin using plain URL text.
