# Cleo POS on Apache or LiteSpeed (Hostinger). Upload this file with the site, in the same folder as
# landing.html. It needs no editing unless the Supabase project changes (see Content-Security-Policy).

# The public landing answers the bare address; index.html is the app itself.
DirectoryIndex landing.html index.html
# An address that does not exist gets a short page (it also sends the old GitHub Pages clean links home).
ErrorDocument 404 /404.html

# No folder listings, and no guessing a file from a similar name.
Options -Indexes -MultiViews

# ---------- HTTPS everywhere ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Send plain http to https (also behind a proxy that ends TLS). Local testing on localhost is left alone.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Only the site's own files are public. Notes, database migrations, build settings and
  # version-control data are refused even if they are uploaded by mistake. (.well-known stays
  # open: the host uses it to renew the HTTPS certificate.)
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule (^|/)\. - [F,L]
  RewriteRule ^(Docs|docs|backend|supabase|source|node_modules|tests|tools|apps|\.github|Cleo-v1\.4-main)(/|$) - [F,L,NC]
  RewriteRule \.(sql|py|sh|env|log|bak|zip|toml|lock|map)$ - [F,L,NC]
  # content/plans.md is the one Markdown file the app reads.
  RewriteCond %{REQUEST_URI} !/content/plans\.md$
  RewriteRule \.md$ - [F,L,NC]

  # ---------- Clean addresses (Docs/design/DESIGN_GUIDELINES.md §H) ----------
  # The old file names move permanently to the clean ones. Each rule tests THE_REQUEST (what the browser
  # asked for), never the rewritten path, so the rewrites below cannot loop. The query string carries over
  # (sign-in callbacks keep their code); the browser keeps the #fragment.
  RewriteCond %{THE_REQUEST} \s/+landing\.html[\s?] [NC]
  RewriteRule ^landing\.html$ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ /app [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+admin\.html[\s?] [NC]
  RewriteRule ^admin\.html$ /admin/ [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+legal/(privacy|terms)\.html[\s?] [NC]
  RewriteRule ^legal/(privacy|terms)\.html$ /$1 [R=301,L]
  # One spelling per page: no trailing slash (relative links in the pages depend on it).
  RewriteRule ^(app|login|signup|plans|privacy|terms)/$ /$1 [R=301,L,NC]
  # The clean addresses serve the files. /login, /signup and /plans open the app on that screen.
  RewriteRule ^(app|login|signup|plans)$ index.html [L]
  RewriteRule ^(privacy|terms)$ legal/$1.html [L]
</IfModule>

# Where mod_rewrite is missing, still refuse dotfiles (for example a local .env).
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# ---------- Security headers ----------
<IfModule mod_headers.c>
  # Browsers remember to use https for a year.
  Header always set Strict-Transport-Security "max-age=31536000"
  # Files are what their type says; nothing is guessed.
  Header always set X-Content-Type-Options "nosniff"
  # Cleo can't be shown inside another site's frame (stops click-hijacking overlays).
  Header always set X-Frame-Options "DENY"
  # Other sites learn only that a visitor came from Cleo, never the page or its address details.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Browser features Cleo doesn't use stay off, even for injected code. The camera stays on for
  # barcode scanning, and USB and serial for printers, scanners and cash drawers.
  Header always set Permissions-Policy "geolocation=(), microphone=(), payment=(), midi=(), gyroscope=(), accelerometer=(), magnetometer=(), browsing-topics=(), camera=(self), usb=(self), serial=(self)"
  # Flash and PDF plugins get no cross-domain policy, and other sites cannot embed Cleo's files as their own.
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  # Windows opened from Cleo can't reach back into it.
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  # What the pages may load and where they may send data: their own files, and the Supabase
  # project for sign-in and data. No other site's scripts run, no plugins, no outside frames,
  # and forms post only to Cleo. Update the two supabase.co addresses if the project changes.
  # script-src lists the fingerprint of each inline script the pages contain, so injected markup
  # cannot run. After ANY edit to index.html or landing.html, run:  node tools/update-security.js
  # (it rewrites this line). A page that shows blank with a policy error in the console needs that.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-0hxYDxLxGI7JOzLDFgK89Dz9pCzJFIngVM0ZTN8PQYU=' 'sha256-2qHDW24pibUG6x0Zyp2g0ygtjpvQa1npdsw/AONoZjs=' 'sha256-4XQ3G9Y/ScpIs8StGRJnXXMiFnhcFdwBGnHz0BPzhOs=' 'sha256-5h4Q9JTk2P9TfG+uEHEJVoXnbfsSF2QKkIZbeWLBrW8=' 'sha256-76WXo1vM/iMo5updzyUJ8+91ZpOen7/gi/ixN0axWpU=' 'sha256-DHNogkMKyaKYt2dSEEjnv3kTvKM+J0i4d9EymcE0X14=' 'sha256-f2xdKiuOPga8+TY7sFKR1FQ6IGxgfGezYcQII2FAQIw=' 'sha256-mSx/DBaK+49230P43FquecnUNurI6lMi4h0sQrmXw6k=' 'sha256-n/rIluhrGHtePSKhrXSA/e+19fr7LUFzC285SaJhwQU=' 'sha256-xcdZGFiRg++qsk1H5HgizqsHIgX70XFFmlx9wsX6qxw='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://ntbkbvlsgymupjdpuvob.supabase.co wss://ntbkbvlsgymupjdpuvob.supabase.co https://api.github.com; worker-src 'self' blob:; manifest-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always unset X-Powered-By
  Header unset X-Powered-By
</IfModule>

# ---------- Fresh pages, cached assets ----------
<IfModule mod_headers.c>
  # The pages and the service worker are always checked for a new version, so a fix reaches every device.
  <FilesMatch "\.(html|webmanifest)$|^sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(woff2|png|svg|jpg|jpeg|webp|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# The admin console is never stored by a browser or a proxy, and never listed by a search engine.
<IfModule mod_headers.c>
  <Files "admin.html">
    Header set Cache-Control "no-store"
    Header set X-Robots-Tag "noindex, nofollow, noarchive"
  </Files>
</IfModule>

# Markdown and the install manifest are served as text the browser can read.
AddType text/markdown .md
AddType application/manifest+json .webmanifest
AddDefaultCharset utf-8
